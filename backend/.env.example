# Copy to .env and adjust. This file is loaded by docker compose (web.env_file)
# and consumed by Django via os.environ.

# --- Docker / compose ---
COMPOSE_PROJECT_NAME=django_next_starter
WEB_PORT=8001
DB_PORT=5432
FRONTEND_PORT=3000

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Admin path prefix (no leading slash). Change it in production.
DJANGO_ADMIN_URL=admin/
# DEBUG -> DEBUG, otherwise INFO. Override with DJANGO_LOG_LEVEL=WARNING etc.
#DJANGO_LOG_LEVEL=INFO

# --- Database (matches docker-compose db service) ---
POSTGRES_DB=django_db
POSTGRES_USER=django
POSTGRES_PASSWORD=django
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Cache ---
# Leave empty in dev (in-process memory cache). Set in production so allauth
# rate limits and DRF throttling are shared across workers.
#REDIS_URL=redis://redis:6379/1

# --- CORS / CSRF (Next.js origin, comma-separated if several) ---
FRONTEND_URL=http://localhost:3000
# Leave empty when frontend and API share a host (localhost). Set to the parent
# domain (e.g. .example.com) when they live on sibling subdomains, otherwise the
# frontend cannot read the csrftoken cookie.
#DJANGO_COOKIE_DOMAIN=.example.com

# --- API throttling (DRF) ---
#DRF_THROTTLE_ANON=60/min
#DRF_THROTTLE_USER=600/min

# --- Email ---
# Dev default prints emails (verification links) to the backend logs.
# Production: DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
#DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
#EMAIL_HOST=smtp.example.com
#EMAIL_PORT=587
#EMAIL_HOST_USER=
#EMAIL_HOST_PASSWORD=
#EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=noreply@localhost
